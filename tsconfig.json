{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@/*": ["./*"]
    },
    "allowJs": true,
    "types": ["bun", "@cloudflare/workers-types", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".void/**/*.d.ts"],
  "exclude": ["node_modules", ".next", "dist", ".wrangler", ".void"]
}
